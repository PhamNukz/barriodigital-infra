# Copia a .env y completa con tus valores reales. No subir el .env real a git.

AAD_ISSUER_URI=https://login.microsoftonline.com/<TENANT_ID>/v2.0
AAD_API_CLIENT_ID=<API_CLIENT_ID>   # GUID pelado, sin api://
AAD_REQUIRED_SCOPE=access_as_user
CORS_ALLOWED_ORIGINS=http://localhost:4200

# IPs privadas de las EC2 (ver barriodigital-docs/AWS-Infraestructura.md)
DB_HOST=10.0.1.8
DB_PORT=1521
DB_SERVICE=FREEPDB1
REQUESTS_DB_USER=barriodigital_requests
REQUESTS_DB_PASSWORD=
CATALOG_DB_USER=barriodigital_catalog
CATALOG_DB_PASSWORD=
AUDIT_DB_USER=barriodigital_audit
AUDIT_DB_PASSWORD=
REPORT_DB_USER=barriodigital_report
REPORT_DB_PASSWORD=

RABBITMQ_HOST=10.0.1.254
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
KAFKA_BOOTSTRAP_SERVERS=10.0.1.29:9092,10.0.1.29:9093,10.0.1.29:9094
